# syntax=docker/dockerfile:1
FROM python:3.11-slim

LABEL maintainer="Aegis Alpha Quantitative Team"
LABEL description="Aegis Alpha Decoupled Streamlit Dashboard UI"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    TRADING_API_BASE_URL=http://dashboard-api:8787

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "streamlit>=1.30.0" \
        "pandas>=2.0.0" \
        "plotly>=5.15.0" \
        "requests>=2.31.0" \
        "pydantic>=2.0.0"

COPY src/ /app/src/
COPY atlas_trading_dashboard/ /app/atlas_trading_dashboard/

EXPOSE 5000

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:5000/_stcore/health || exit 1

CMD ["streamlit", "run", "/app/atlas_trading_dashboard/app.py", \
     "--server.port=5000", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.enableCORS=false", \
     "--browser.gatherUsageStats=false"]
