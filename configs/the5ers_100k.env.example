# ==============================================================================
# Aegis Alpha — The5ers $100,000 Prop Firm Node Configuration
# Calibrated for The5ers High-Stakes / 1-Step (0.30% Risk for 3.0% Daily Loss Limit)
# ==============================================================================

# Broker Connection Profile
ACCOUNT_PREFIX=THE5ERS
THE5ERS_LOGIN=your_the5ers_login_here
THE5ERS_PASSWORD=your_the5ers_password_here
THE5ERS_SERVER="FivePercent-Server"

# Terminal Paths & Networking
MT5_TERMINAL_PATH=/app/data/terminal/terminal64.exe
BRIDGE_PORT=8888
NOVNC_PORT=8083

# Strategy & Asset Execution
SYMBOL=XAUUSD
STRATEGY_MODE=FLAT_RISK_TOUCH
TIMEFRAME=1h

# Prop Firm Risk Calibration: 0.30% Risk ($300 per trade on $100k)
# 10 consecutive losses required to breach the 3% daily limit
RISK_MODE=PERCENT
RISK_PCT=0.30
MIN_RR=1.25
SCALE_OUT_R=1.25
RUNNER_TRAIL_BUFFER=4.50
RUNNER_TARGET_2_MULTIPLIER=2.00

# Concurrency & Runner Compounding
# Maximum 1 trade with downside risk; 2nd trade only unlocked when 1st is risk-free
MAX_POSITIONS=2
MAX_UNHEDGED_POSITIONS=1
ALLOW_RUNNER_COMPOUNDING=true

# Execution Filters
ONE_TRADE_PER_BAR=true
REQUIRE_SLOPE_ALIGNMENT=true
ENABLE_ML_FILTER=false
ENABLE_NEWS_GUARD=true
NEWS_GUARD_BUFFER_MINUTES=15
ENABLE_SESSION_FILTER=true
MAX_DAILY_TRADES=6
LOSS_COOLDOWN_MINUTES=60
SCAN_INTERVAL_SECONDS=60
ACTIVE_INTERVAL_SECONDS=5
ORDER_TAG=The5ers100k
